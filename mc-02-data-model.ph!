// --- 1. PENGATURAN KOLOM ADMIN (LIST VIEW) ---
add_filter('manage_pr_item_posts_columns', function($columns) {
    return [
        'cb'        => $columns['cb'],
        'sku_code'  => 'Kode SKU',
        'title'     => 'Nama Item',
        'item_type' => 'Tipe',
        'denom'     => 'Denom',
        'stock'     => 'Stok',
        'price'     => 'Harga / HPP',
    ];
});

add_action('manage_pr_item_posts_custom_column', function($column, $post_id) {
    global $wpdb;
    switch ($column) {
        case 'sku_code':
            $sku = get_post_meta($post_id, 'item_sku_code', true);
            echo '<code class="puri-sku-tag">' . esc_html($sku ?: '-') . '</code>';
            break;

        case 'item_type':
            $type = get_field('type', $post_id);
            $labels = ['currency' => 'Valas', 'goods' => 'Retail', 'package' => 'Paket'];
            $label = $labels[$type] ?? $type;
            $class = ($type === 'currency') ? 'blue' : (($type === 'package') ? 'purple' : 'gray');
            echo "<span class='puri-badge $class'>" . strtoupper($label) . "</span>";
            break;

        case 'denom':
            $denom = get_field('denom_value', $post_id);
            echo ($denom > 0) ? "<strong>" . number_format($denom) . "</strong>" : "<span style='color:#ccc'>-</span>";
            break;

        case 'stock':
            $table = (defined('T_STOCK')) ? puri_table_name('T_STOCK') : $wpdb->prefix . 'puri_inventory_balance';
            $qty = $wpdb->get_var($wpdb->prepare("SELECT qty_balance FROM $table WHERE item_id = %d", $post_id));
            echo "<strong>" . number_format($qty ?: 0) . "</strong>";
            break;

        case 'price':
            $sell = get_field('sell_rate', $post_id);
            $avg = get_post_meta($post_id, 'base_price', true);
            echo "<div style='font-size:11px;'>";
            echo "Jual: <span style='color:#2563eb; font-weight:700;'>" . number_format($sell ?: 0) . "</span><br>";
            echo "HPP: <span style='color:#059669;'>" . number_format($avg ?: 0) . "</span>";
            echo "</div>";
            break;
    }
}, 10, 2);

