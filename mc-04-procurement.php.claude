defined('ABSPATH') || exit;

add_action('admin_menu', function() {
    add_submenu_page('puri-transaksi', 'Procurement / Kulakan', '📦 Kulakan Brot', 'manage_options', 'puri-procurement', 'puri_render_procurement_page');
}, 20);

function puri_render_procurement_page() {
    puri_check_cap('manage_options');
    global $wpdb;
    
    $items = $wpdb->get_results("SELECT id, wp_post_id, sku, name, denom_value FROM ".puri_table_name('T_ITEMS')." WHERE type = 'currency' ORDER BY denom_value ASC");
    $vendors = get_posts(['post_type' => 'pr_vendor', 'posts_per_page' => -1, 'post_status' => 'publish', 'orderby' => 'title', 'order' => 'ASC']);
    $banks = $wpdb->get_results("SELECT code, name FROM ".puri_table_name('T_CHART')." WHERE is_cash = 1 ORDER BY code ASC");

    if (isset($_GET['puri_procure_ok'])) echo '<div class="notice notice-success"><p>✅ '.esc_html(urldecode($_GET['puri_procure_ok'])).'</p></div>';
    if (isset($_GET['puri_procure_err'])) echo '<div class="notice notice-error"><p>❌ '.esc_html(urldecode($_GET['puri_procure_err'])).'</p></div>';
    ?>
    <style>
        .proc-container{display:grid;grid-template-columns:220px 1fr 380px;gap:20px;margin-top:20px}
        .proc-panel{background:#fff;border:1px solid #d1d5db;border-radius:8px;padding:16px}
        .proc-listbox{width:100%;height:400px;border:1px solid #cbd5e1;border-radius:4px}
        .proc-tabs{display:flex;gap:8px;margin-bottom:16px;border-bottom:2px solid #e5e7eb;padding-bottom:8px}
        .proc-tab{padding:8px 16px;background:#f1f5f9;border:none;cursor:pointer;border-radius:4px 4px 0 0;font-weight:600}
        .proc-tab:hover{background:#e2e8f0}
        .proc-tab.active{background:#7c3aed;color:#fff}
        .proc-row{display:grid;gap:8px;align-items:center;margin-bottom:8px}
        .proc-row.nominal{grid-template-columns:150px 110px 100px 100px 130px 40px}
        .proc-row.quantity{grid-template-columns:150px 100px 100px 110px 130px 40px}
        .proc-row input,.proc-row select{padding:7px 6px;border:1px solid #cbd5e1;border-radius:4px;text-align:right;width:100%;box-sizing:border-box;font-size:14px}
        .proc-row select{text-align:left}
        .proc-row .readonly{background:#f8fafc;color:#64748b;font-weight:600;border-color:#e2e8f0}
        .btn-remove{color:#ef4444;border:1px solid #ef4444;background:#fff;cursor:pointer;border-radius:4px;padding:4px 10px}
        .proc-payment-row{display:grid;grid-template-columns:1fr 120px 30px;gap:5px;margin-bottom:8px}
        .proc-summary{background:#f8fafc;padding:12px;border-radius:6px;margin:12px 0}
        .proc-summary-row{display:flex;justify-content:space-between;padding:6px 0}
        .proc-summary-row.total{font-weight:900;font-size:18px;border-top:2px solid #0f172a;padding-top:10px;margin-top:8px}
        .btn-submit{width:100%;padding:12px;background:#059669;color:#fff;border:none;border-radius:6px;font-weight:900;font-size:16px;cursor:pointer}
        .btn-submit:disabled{background:#cbd5e1;cursor:not-allowed}
    </style>

    <div class="wrap">
        <h1>📦 Procurement Hub v7.2.12</h1>
        <form method="post" id="proc_form" action="<?php echo admin_url('admin-post.php'); ?>">
            <?php wp_nonce_field('puri_procure_action', 'puri_procure_nonce'); ?>
            <input type="hidden" name="action" value="puri_procure_submit">
            <input type="hidden" name="mode" id="proc_mode" value="nominal">
            <input type="hidden" name="vendor_id" id="vendor_id_hidden">

            <div class="proc-container">
                <div class="proc-panel">
                    <h3>Vendor *</h3>
                    <select id="vendor_listbox" class="proc-listbox" size="20">
                        <option value="">-- Pilih --</option>
                        <?php foreach ($vendors as $v): ?>
                            <option value="<?php echo $v->ID; ?>"><?php echo esc_html($v->post_title); ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>

                <div class="proc-panel">
                    <div class="proc-tabs">
                        <button type="button" class="proc-tab active" id="tab_nominal">BY NOMINAL</button>
                        <button type="button" class="proc-tab" id="tab_qty">BY QUANTITY</button>
                    </div>

                    <div id="header_row" class="proc-row nominal" style="font-weight:700;background:#f1f5f9;padding:8px 4px;border-radius:4px">
                        <div>Item</div>
                        <div id="lbl_col2" style="text-align:right">Total SAR</div>
                        <div style="text-align:right">Kurs Beli</div>
                        <div id="lbl_col4" style="text-align:right">Qty (Lbr)</div>
                        <div style="text-align:right">Total IDR</div>
                        <div></div>
                    </div>

                    <div id="proc_rows"></div>
                    <button type="button" id="btn_add_row" class="button">+ Tambah Item</button>

                    <div class="proc-summary">
                        <div class="proc-summary-row total">
                            <span>TOTAL</span>
                            <span>Rp <span id="total_pembelian">0</span></span>
                        </div>
                    </div>

                    <input type="checkbox" id="confirm_data"> <label for="confirm_data">Data Benar</label><br>
                    <button type="submit" id="btn_submit" class="btn-submit" disabled style="margin-top:10px">SUBMIT</button>
                </div>

                <div class="proc-panel">
                    <h3>Pembayaran *</h3>
                    <div id="payment_sources"></div>
                    <button type="button" id="btn_add_payment" class="button" style="width:100%;margin-top:8px">+ Tambah</button>
                    <div id="selisih_row" style="margin-top:15px;color:#ef4444;font-weight:bold">
                        <span id="selisih_label">SELISIH:</span> Rp <span id="selisih_amount">0</span>
                    </div>
                </div>
            </div>
        </form>

        <div class="proc-panel" style="margin-top:20px">
            <h3>📋 Riwayat 15 Terakhir</h3>
            <table class="widefat striped">
                <thead><tr><th>Tanggal</th><th>Ref</th><th>Keterangan</th><th style="text-align:right">IDR</th></tr></thead>
                <tbody>
                    <?php
                    $hist = $wpdb->get_results("SELECT ref_id, MIN(trx_date) as tgl, MIN(description) as ket, SUM(debit) as total FROM ".puri_table_name('T_JOURNAL')." WHERE ref_id LIKE 'PRO-%' AND debit > 0 GROUP BY ref_id ORDER BY tgl DESC LIMIT 15");
                    if ($hist) { foreach ($hist as $h) {
                        echo "<tr><td>".date('d/m H:i', strtotime($h->tgl))."</td><td><code>{$h->ref_id}</code></td><td>{$h->ket}</td><td style='text-align:right;font-weight:bold'>Rp ".number_format($h->total)."</td></tr>";
                    } } else { echo "<tr><td colspan='4' align='center'>Belum ada data</td></tr>"; }
                    ?>
                </tbody>
            </table>
        </div>
    </div>

    <script>
    (function() {
        const items = <?php echo wp_json_encode($items); ?>;
        const banks = <?php echo wp_json_encode($banks); ?>;
        let mode = 'nominal', rIdx = 0, pIdx = 0, isModeLocked = false;

        const fmt = n => new Intl.NumberFormat('id-ID').format(parseFloat(n || 0));
        const cln = v => parseFloat(String(v || '').replace(/\./g, '').replace(',', '.').replace(/[^\d\.\-]/g, '') || 0);

        function updateTotals() {
            let bel = 0;
            const rows = document.querySelectorAll('#proc_rows .proc-row');
            rows.forEach(r => {
                const idrInput = r.querySelector('.c-idr input');
                if (idrInput) {
                    const val = cln(idrInput.value);
                    bel += val;
                }
            });
            
            document.getElementById('total_pembelian').textContent = fmt(bel);
            
            let bay = 0;
            const payRows = document.querySelectorAll('#payment_sources .proc-payment-row');
            payRows.forEach(r => {
                const payInput = r.querySelector('.pay-amt');
                if (payInput) {
                    bay += cln(payInput.value);
                }
            });
            
            const diff = Math.abs(bay - bel);
            document.getElementById('selisih_amount').textContent = fmt(diff);
            
            const isKlop = diff < 1 && bel > 0;
            const vendorSelected = document.getElementById('vendor_id_hidden').value !== '';
            const confirmed = document.getElementById('confirm_data').checked;
            
            const canSubmit = isKlop && vendorSelected && confirmed;
            document.getElementById('btn_submit').disabled = !canSubmit;
            
            // Visual feedback untuk selisih
            const selisihRow = document.getElementById('selisih_row');
            if (isKlop && bel > 0) {
                selisihRow.style.color = '#10b981';
                document.getElementById('selisih_label').textContent = 'KLOP:';
            } else {
                selisihRow.style.color = '#ef4444';
                document.getElementById('selisih_label').textContent = 'SELISIH:';
            }
        }

        function buildRow() {
            const idx = rIdx++;
            const row = document.createElement('div');
            row.className = 'proc-row ' + mode;
            row.innerHTML = `
                <div><select name="items[${idx}][id]" required><option value="">-- Item --</option>${items.map(i=>`<option value="${i.wp_post_id}" data-denom="${i.denom_value}">${i.sku}</option>`).join('')}</select></div>
                <div class="c-col2"><input type="text"></div>
                <div><input type="text" name="items[${idx}][kurs]"></div>
                <div class="c-col4"><input type="text"></div>
                <div class="c-idr"><input type="text" class="readonly" readonly value="0"></div>
                <div><button type="button" class="btn-remove">×</button></div>
            `;

            const sel = row.querySelector('select'), c2 = row.querySelector('.c-col2 input'),
                  ks = row.querySelector('input[name*="kurs"]'), c4 = row.querySelector('.c-col4 input'),
                  idr = row.querySelector('.c-idr input');

            function recalc() {
                const den = cln(sel.selectedOptions[0]?.dataset.denom || 1), kurs = cln(ks.value);
                let sar, qty;
                
				// Lock mode after first meaningful input
				if (!isModeLocked && (cln(c2.value) > 0 || cln(ks.value) > 0)) {
					isModeLocked = true;
					document.getElementById('tab_nominal').disabled = true;
					document.getElementById('tab_qty').disabled = true;
					document.getElementById('tab_nominal').style.opacity = '0.5';
					document.getElementById('tab_qty').style.opacity = '0.5';
					document.getElementById('tab_nominal').style.cursor = 'not-allowed';
					document.getElementById('tab_qty').style.cursor = 'not-allowed';
				}
				
				
                if (mode === 'nominal') {
                    sar = cln(c2.value); qty = den > 0 ? sar / den : 0;
                    c4.value = fmt(qty);
                    c2.name = `items[${idx}][total_riyal]`; c4.name = `items[${idx}][qty]`;
                } else {
                    qty = cln(c2.value); sar = qty * den;
                    c4.value = fmt(sar);
                    c2.name = `items[${idx}][qty]`; c4.name = `items[${idx}][total_riyal]`;
                }
                
                idr.value = fmt(sar * kurs);
                updateTotals();
            }

            [sel, c2, ks, c4].forEach(el => {
                el.onchange = recalc;
                el.oninput = recalc;
                el.onkeyup = recalc;
            });
			row.querySelector('.btn-remove').onclick = () => { 
				row.remove();
				
				// Unlock mode jika semua baris kosong
				setTimeout(() => {
					if (document.querySelectorAll('#proc_rows .proc-row').length === 0) {
						isModeLocked = false;
						document.getElementById('tab_nominal').disabled = false;
						document.getElementById('tab_qty').disabled = false;
						document.getElementById('tab_nominal').style.opacity = '1';
						document.getElementById('tab_qty').style.opacity = '1';
						document.getElementById('tab_nominal').style.cursor = 'pointer';
						document.getElementById('tab_qty').style.cursor = 'pointer';
					}
					updateTotals();
				}, 50);
			};

            document.getElementById('proc_rows').appendChild(row);
            applyRowMode(row);
            setTimeout(updateTotals, 100);
        }

        function applyRowMode(r) {
            r.className = 'proc-row ' + mode;
            const c2 = r.querySelector('.c-col2 input'), c4 = r.querySelector('.c-col4 input');
            if (mode === 'nominal') {
                c2.readOnly = false; c2.classList.remove('readonly');
                c4.readOnly = true; c4.classList.add('readonly');
            } else {
                c2.readOnly = false; c2.classList.remove('readonly');
                c4.readOnly = true; c4.classList.add('readonly');
            }
        }

        function buildPaymentRow() {
            const idx = pIdx++;
            const div = document.createElement('div');
            div.className = 'proc-payment-row';
            div.innerHTML = `<select name="payments[${idx}][account]" required><option value="">-- Sumber --</option>${banks.map(b=>`<option value="${b.code}">${b.name}</option>`).join('')}</select>
                             <input type="text" name="payments[${idx}][amount]" class="pay-amt">
                             <button type="button" class="btn-remove">×</button>`;
            div.querySelector('.pay-amt').oninput = function() { this.value = fmt(cln(this.value)); updateTotals(); };
            div.querySelector('.btn-remove').onclick = () => { div.remove(); updateTotals(); };
            document.getElementById('payment_sources').appendChild(div);
        }

        function switchMode(m) {
			if (isModeLocked) {
				alert('⚠️ Mode tidak bisa diubah karena sudah ada input data!\n\nHapus semua baris untuk mengubah mode.');
				return;
			}
			
            mode = m;
            document.getElementById('proc_mode').value = m;
            document.getElementById('tab_nominal').classList.toggle('active', m === 'nominal');
            document.getElementById('tab_qty').classList.toggle('active', m === 'quantity');
            document.getElementById('header_row').className = 'proc-row ' + m;
            document.getElementById('lbl_col2').textContent = m === 'nominal' ? 'Total SAR' : 'Qty (Lbr)';
            document.getElementById('lbl_col4').textContent = m === 'nominal' ? 'Qty (Lbr)' : 'Total SAR';
            document.querySelectorAll('.proc-row').forEach(applyRowMode);
        }

        document.getElementById('tab_nominal').onclick = () => switchMode('nominal');
        document.getElementById('tab_qty').onclick = () => switchMode('quantity');
        document.getElementById('vendor_listbox').onchange = function() { document.getElementById('vendor_id_hidden').value = this.value; updateTotals(); };
        document.getElementById('btn_add_row').onclick = buildRow;
        document.getElementById('btn_add_payment').onclick = buildPaymentRow;
        document.getElementById('confirm_data').onchange = updateTotals;
        
        buildRow(); buildPaymentRow();
    })();
    </script>
<?php
}

// ════════════════════════════════════════════════════════════════════════════
// SUBMIT HANDLER - MOZART BACKEND v7.2
// ════════════════════════════════════════════════════════════════════════════
add_action('admin_post_puri_procure_submit', 'puri_handle_procurement_submit');

function puri_handle_procurement_submit() {
    check_admin_referer('puri_procure_action', 'puri_procure_nonce');
    puri_check_cap('manage_options');
    global $wpdb;
    
    if (!function_exists('puri_mozart')) wp_die('Mozart Engine tidak ditemukan. Aktifkan MC-03.');
    $mozart = puri_mozart();
    
    $vendor_id = intval($_POST['vendor_id'] ?? 0);
    $mode = $_POST['mode'] ?? 'nominal';
    $items = $_POST['items'] ?? [];
    $payments = $_POST['payments'] ?? [];
    
    if (!$vendor_id || empty($items) || empty($payments)) {
        wp_redirect(add_query_arg('puri_procure_err', urlencode('Data tidak lengkap!'), admin_url('admin.php?page=puri-procurement')));
        exit;
    }
    
    $ref_id = 'PRO-' . date('ymdHi') . wp_rand(100, 999);
    $wpdb->query('START TRANSACTION');
    
    try {
        $total_belanja = 0;
        $items_processed = [];
        $vendor_name = get_the_title($vendor_id);
    // Helper untuk parse number Indonesia format
    $parse_id_number = function($val) {
        $clean = str_replace(['.', ','], ['', '.'], trim($val));
        return floatval($clean);
    };
      
    foreach ($items as $item) {
        $wp_post_id = intval($item['id']);
        $qty_input = $parse_id_number($item['qty']);
        $kurs_input = $parse_id_number($item['kurs']);
        $total_riyal_input = $parse_id_number($item['total_riyal']);
        
        // Skip invalid entries
        if (!$wp_post_id || $qty_input <= 0 || $kurs_input <= 0) {
            error_log("Skipped invalid item: wp_post_id={$wp_post_id}, qty={$qty_input}, kurs={$kurs_input}");
            continue;
        }
        
        // Bridging WP ID → SQL ID
        $sql_item_id = puri_get_item_sql_id($wp_post_id);
        if (!$sql_item_id) {
            error_log("Failed to get SQL ID for WP Post ID: {$wp_post_id}");
            continue;
        }
        
        $item_data = $wpdb->get_row($wpdb->prepare(
            "SELECT denom_value, name, sku FROM ".puri_table_name('T_ITEMS')." WHERE id = %d",
            $sql_item_id
        ));
        
        if (!$item_data) {
            error_log("Item data not found for SQL ID: {$sql_item_id}");
            continue;
        }
        
        $denom = floatval($item_data->denom_value ?: 1);
        $total_riyal = $total_riyal_input;
        $unit_price = ($denom > 0) ? ($kurs_input * $denom) : $kurs_input;
        $subtotal = $total_riyal * $kurs_input;
		$loc_id = sanitize_text_field($_POST['location_id'] ?? puri_get_default_location());
        
        // Primary payment account
        $primary_payment_acc = isset($payments[0]['account']) ? $payments[0]['account'] : puri_gl('ap_trade');
        
        // Prepare Mozart parameters
        $mozart_params = [
            'item_id'         => intval($sql_item_id),
            'qty'             => floatval($qty_input),
            'unit_price'      => floatval($unit_price),
            'ref_no'          => sanitize_text_field($ref_id),
            'description'     => sanitize_text_field("Procurement: {$item_data->name} via {$vendor_name}"),
            'location_id'     => $loc_id;
            'payment_account' => sanitize_text_field($primary_payment_acc)
        ];
        
        // Debug log
        if (defined('WP_DEBUG') && WP_DEBUG) {
            error_log("Mozart Params: " . json_encode($mozart_params));
        }
        
        // Mozart Engine Call
        $res = $mozart->execute('procurement', $mozart_params);
        
        if (is_wp_error($res)) {
            $error_msg = $res->get_error_message();
            error_log("Mozart failed for item {$item_data->sku}: {$error_msg}");
            throw new Exception("Item {$item_data->sku}: {$error_msg}");
        }
        
        $items_processed[] = [
            'id'          => $sql_item_id,
            'sku'         => $item_data->sku,
            'qty'         => $qty_input,
            'kurs'        => $kurs_input,
            'total_riyal' => $total_riyal,
            'subtotal'    => $subtotal
        ];
        
        $total_belanja += $subtotal;
    }   
	
        if (empty($items_processed)) throw new Exception('Tidak ada item valid yang diproses');
        
        // Validasi Pembayaran
        $total_bayar = 0;
        foreach ($payments as $pmt) {
            $amount = floatval(str_replace(['.', ','], ['', '.'], $pmt['amount'] ?? '0'));
            if ($amount <= 0) continue;
            $total_bayar += $amount;
        }
        
        if (abs($total_bayar - $total_belanja) > 1) {
            throw new Exception(sprintf(
                'MISMATCH: Total pembayaran (Rp %s) vs Total belanja (Rp %s)',
                number_format($total_bayar),
                number_format($total_belanja)
            ));
        }
        
        $wpdb->query('COMMIT');
        
        wp_redirect(add_query_arg('puri_procure_ok',
            urlencode("Berhasil! Ref: {$ref_id} | Total: Rp " . number_format($total_belanja)),
            admin_url('admin.php?page=puri-procurement')
        ));
        exit;
        
    } catch (Exception $e) {
        $wpdb->query('ROLLBACK');
        wp_redirect(add_query_arg('puri_procure_err',
            urlencode('ERROR: ' . $e->getMessage()),
            admin_url('admin.php?page=puri-procurement')
        ));
        exit;
    }
}

// ════════════════════════════════════════════════════════════════════════════
// HELPER: MOZART BRIDGE (WP Post ID → SQL Item ID)
// ════════════════════════════════════════════════════════════════════════════
if (!function_exists('puri_get_item_sql_id')) {
    function puri_get_item_sql_id($wp_post_id) {
        global $wpdb;
        $table = puri_table_name('T_ITEMS');
        
        $sql_id = $wpdb->get_var($wpdb->prepare(
            "SELECT id FROM {$table} WHERE wp_post_id = %d",
            intval($wp_post_id)
        ));
        
        if ($sql_id) return $sql_id;
        
        // Auto-Sync jika belum ada
        $sku = get_post_meta($wp_post_id, 'item_sku_code', true) ?: 'SKU-' . $wp_post_id;
        $name = get_the_title($wp_post_id);
        $type = get_post_meta($wp_post_id, 'item_type', true) ?: 'currency';
        $denom = get_post_meta($wp_post_id, 'denom_value', true) ?: 1;
        
        $inserted = $wpdb->insert($table, [
            'wp_post_id' => intval($wp_post_id),
            'sku' => sanitize_text_field($sku),
            'name' => sanitize_text_field($name),
            'type' => sanitize_text_field($type),
            'denom_value' => floatval($denom),
            'base_price' => 0,
            'sell_rate' => 0
        ]);
        
        return $inserted ? $wpdb->insert_id : false;
    }
}